# =============================================================================
# ClickUp All - Environment Variables
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=5014
TZ=Africa/Cairo

# ClickUp API Configuration
CLICKUP_API_TOKEN=your_clickup_api_token_here
CLICKUP_TEAM_ID=your_team_id_here
CLICKUP_SAMPLE_LIST_ID=your_sample_list_id_here

# AI Configuration - Choose Your Provider
# Options: 'claude' or 'openai' or 'gemini'
AI_PROVIDER=openai

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your_claude_api_key_here

# OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Configuration
WHATSAPP_GROUP_NAME=Click Up notification 📢

# Feature Toggles
ENABLE_AI_NOTIFICATIONS=true
ENABLE_ENHANCED_MOTIVATION=true
ENABLE_DAILY_REPORTS=true
ENABLE_WEEKLY_CHALLENGES=true
ENABLE_BADGES=true
ENABLE_COURSES=true
ENABLE_INSPIRATIONAL_CONTENT=true

# Notification Settings
NOTIFICATION_BATCH_DELAY=60000
NOTIFICATION_PAUSE_DURATION=600000

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
